# Copy to .env.local and fill in your values
# Project: savitz25 / Move Trust Hub

# Supabase — public (safe for browser + Vercel)
# PRO / production project (are) — auth + Save My Move live here:
NEXT_PUBLIC_SUPABASE_URL=https://arepfylnilkjmyduhwbz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<are-publishable-anon-key>
# Supabase Dashboard → Auth → URL Configuration: Site URL must be https://www.movetrusthub.com (not localhost)

# Supabase — server ONLY (never NEXT_PUBLIC_). Vercel: Production + Preview.
SUPABASE_SERVICE_ROLE_KEY=<are-service-role-secret>

# FREE → PRO data migration only (npm run migrate:uvq-to-are)
# SOURCE_SUPABASE_URL=https://uvqkyupfnpswdozmuzih.supabase.co
# SOURCE_SUPABASE_SERVICE_ROLE_KEY=<uvq-service-role-secret>
# Optional aliases: FREE_SUPABASE_* / TARGET_SUPABASE_* / PRO_SUPABASE_*

# Optional — personal access token to apply branded Auth email templates via Management API
# https://supabase.com/dashboard/account/tokens  (not the service role key)
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=uvqkyupfnpswdozmuzih

# Direct Postgres (for scripts/run-key-migrations.ts and backfill scripts)
# Supabase Dashboard → Project Settings → Database → Connection string (password)
SUPABASE_DB_PASSWORD=<database-password>
# Or full URL:
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

# Admin dashboard (/admin/quotes) — server ONLY
ADMIN_SECRET=<long-random-string>

# Pre-filled identity when logged in at /admin (verify-dot directory onboarding)
ADMIN_SUBMITTER_NAME=Michael Henry
ADMIN_SUBMITTER_EMAIL=info@movetrusthub.com

# FMCSA QCMobile API web key — /verify-dot + automated directory refresh
# Register at https://mobile.fmcsa.dot.gov/QCDevsite/docs/api
FMCSA_WEB_KEY=

# Cron / GitHub Actions auth for /api/refresh/fmcsa (server ONLY)
CRON_SECRET=<long-random-string>

# Google OAuth web client ID — Save My Move GSI button + Supabase Google provider
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs (Web)
# Must match the Client ID configured in Supabase Auth → Providers → Google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Places API — company onboarding enrichment (Places API New)
# Enable "Places API (New)" in Google Cloud Console
GOOGLE_PLACES_API_KEY=

# BBB API — business profile lookup (register at https://api.bbb.org)
BBB_API_KEY=

# Optional bulk CSV fallback when API is unavailable
# Columns: slug,name,bbbId,businessId,rating,accredited,complaints,reviews,alerts
BBB_BULK_CSV_PATH=

# BBB refresh alerts (defaults to savitz25@gmail.com)
BBB_ALERT_EMAIL=savitz25@gmail.com

# FMCSA refresh alerts (defaults to savitz25@gmail.com)
FMCSA_ALERT_EMAIL=savitz25@gmail.com

# Optional RingCentral SMS alerts on critical FMCSA changes
FMCSA_ALERT_SMS_TO=
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_FROM_NUMBER=
RINGCENTRAL_SERVER=https://platform.ringcentral.com

# Google Analytics 4 — host-aware (see lib/analytics/ga-config.ts)
# Move stream (www.movetrusthub.com) — REQUIRED in Vercel Production:
#   Stream: Move Trust Hub · Stream ID 15104924379 · Measurement ID G-433BDVV8MJ
# NOTE: G-433BDV8MJ (one V) is a known broken typo — do not use it.
NEXT_PUBLIC_GA_MEASUREMENT_ID_MOVE=G-433BDVV8MJ
# Legacy alias (Move only). Prefer NEXT_PUBLIC_GA_MEASUREMENT_ID_MOVE.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-433BDVV8MJ
# InsuranceTrustHub only (optional). Never set to the Move ID.
# NEXT_PUBLIC_GA_MEASUREMENT_ID_INSURANCE=

# Quote form emails (Resend)
RESEND_API_KEY=
RESEND_FROM=Move Trust Hub <notifications@movetrusthub.com>
QUOTE_TEAM_EMAIL=mhenry@amerisafemoving.com

# Brevo CRM + automation (Website Leads list)
BREVO_API_KEY=
BREVO_LIST_ID=7

# Vercel Edge Config — performance flags (see config/edge-config.performance.json)
# Created in Vercel → Storage → Edge Config → link to project (auto-sets EDGE_CONFIG).
# EDGE_CONFIG=https://edge-config.vercel.com/...
