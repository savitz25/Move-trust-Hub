const claim = readFileSync('lib/customer-integration/eligibility.ts', 'utf8');
const interpret = readFileSync('lib/move-ask/interpret.ts', 'utf8');

assert.match(page, /NORTH_CAROLINA_INTELLIGENCE_GATE.path|path: '\/north-carolina'/);
assert.match(page, /getNorthCarolinaMoveIntelligence/);
assert.equal((ui.match(/<h1\b/g) ?? []).length, 1);
assert.match(ui, /North Carolina Moving/);
assert.match(ui, /not FMCSA interstate authority/i);
assert.match(ui, /C-number is not a T-number/);
assert.match(ui, /Maximum Rate Tariff is not a quote/);
