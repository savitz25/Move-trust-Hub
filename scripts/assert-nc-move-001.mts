assert.equal(snap.enforcement.NC_NCUC_HHG_ENFORCEMENT_ROWS, null);
assert.equal(snap.claimEligibilityBroadened, false);
assert.equal(snap.fingerprint, '9b4becfd1d99f78abdbe79daabb0ba61571e6b6fc3e13f8fb1dc439661e46bec');
assert.match(claim, /usdotNumber/);
assert.doesNotMatch(claim, /nc-ncuc|cNumber/i);
assert.match(interpret, /north carolina|ncuc|c-number/i);
