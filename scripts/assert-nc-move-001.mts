assert.doesNotMatch(sitemap, /\/north-carolina\/charlotte/);
assert.doesNotMatch(sitemap, /\/north-carolina\/raleigh/);
assert.ok(MOVE_HOMEPAGE_STATE_CARDS.some((state) => state.href === '/north-carolina'));
assert.match(nav, /href: '\/north-carolina'/);
assert.equal(existsSync('app/(move)/north-carolina/charlotte'), false);
assert.equal(existsSync('app/(move)/north-carolina/raleigh'), false);
assert.equal(snap.current_hhg_roster.NC_NCUC_DISTINCT_C_NUMBERS, 362);
